# Copiez ce fichier en .env et collez votre clé (https://developer.riotgames.com).
# La clé de développement expire toutes les 24 h : à régénérer.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Serveur de jeu : euw1, eun1, na1, kr... La région de routage s'en déduit (RIOT_REGION pour la forcer).
RIOT_PLATFORM=euw1
